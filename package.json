{
  "name": "terravalle-backend",
  "version": "1.0.0",
  "description": "API del proyecto TerraValle, plataforma web progresiva (PWA) de bienes raíces que permite publicar inmuebles mediante **fichas técnicas estandarizadas** y obtener una **estimación orientativa de precio asistida por IA**.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-timeout=30000",
    "test:coverage": "node --test --test-timeout=30000 --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info",
    "migrate:up": "node-pg-migrate -m migrations -d MIGRATION_DATABASE_URL --envPath .env up",
    "migrate:down": "node-pg-migrate -m migrations -d MIGRATION_DATABASE_URL --envPath .env down",
    "migrate:redo": "node-pg-migrate -m migrations -d MIGRATION_DATABASE_URL --envPath .env redo",
    "migrate:status": "node scripts/migrate-status.js",
    "migrate:baseline": "node-pg-migrate -m migrations -d MIGRATION_DATABASE_URL --envPath .env up 1 --fake",
    "migrate:create": "node-pg-migrate create -m migrations -j js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevJIE-Network/terravalle-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "bugs": {
    "url": "https://github.com/DevJIE-Network/terravalle-backend/issues"
  },
  "homepage": "https://github.com/DevJIE-Network/terravalle-backend#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14"
  }
}
